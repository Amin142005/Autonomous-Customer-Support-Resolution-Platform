# Local demo settings. Replace the JWT placeholder for any non-demo environment.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=replace-with-a-local-secret
SUPABASE_JWT_SECRET=

# Persistence and cache
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
REDIS_URL=
USE_FAKE_REDIS=true

# Model and knowledge providers
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-hash
EMBEDDING_DIMENSIONS=384
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# Tool policy and application limits
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
